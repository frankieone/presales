# Copy to .env.local (never commit it) and fill in the FrankieOne account.
# These values reach the browser bundle — use a demo account only.

# FrankieOne API
VITE_FRANKIE_API_URL=https://api.uat.frankie.one
VITE_FRANKIE_CUSTOMER_ID=
VITE_FRANKIE_CUSTOMER_CHILD_ID=
VITE_FRANKIE_API_KEY=

# OneSDK session server (embedded device capture)
VITE_FRANKIE_BFF_URL=https://backend.kycaml.uat.frankiefinancial.io

# Sardine device listener
VITE_SARDINE_CLIENT_ID=
VITE_SARDINE_ENV=sandbox

# Shown in the banner at the top of every screen
VITE_ENV_LABEL=Demo account · FrankieOne UAT
