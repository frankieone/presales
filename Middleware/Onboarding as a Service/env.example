# Copy to .env.local and fill in. Read by the platform server only: none of
# these values reach a browser, which is the point of the pattern.

# The one FrankieOne account every intermediary runs through
FRANKIE_API_URL=https://api.uat.frankie.one
FRANKIE_CUSTOMER_ID=
FRANKIE_CUSTOMER_CHILD_ID=
FRANKIE_API_KEY=
FRANKIE_SERVICE_NAME=DEFAULT

# Derives client handles, the identity index and intermediary tokens.
# Any long random string; changing it re-keys everything.
PLATFORM_SECRET=

# Shown in the banner on every screen
ENV_LABEL=Demo account · FrankieOne UAT

# Policies (optional)
MIN_RESPONSE_MS=6000
RATE_PER_MINUTE=30
REUSE_WINDOW_DAYS=90
MAX_CONCURRENT=4
